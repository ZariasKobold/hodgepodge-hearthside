# Where the model register lives. Only used by the dev proxy and the seed script.
VITE_REGISTRY_UPSTREAM=https://biggerhat.net

# Base path the app calls. Leave as-is to go through the dev proxy.
VITE_REGISTRY_BASE=/api/v1

# Set to "local" to read public/register.json instead of the network.
# Run `npm run seed` first to generate it.
VITE_REGISTRY_MODE=remote

# Opens the wizard without an account, and ONLY when the accounts backend is
# unreachable — which is every `npm run dev`, since Vite serves no Functions.
# Without this, local UI work is impossible: play is gated behind sign-in, and
# signing in needs a registered redirect URI that localhost does not have.
# Never set in production; it is not among wrangler.toml's [vars], so deployed
# builds cannot carry it.
VITE_ALLOW_UNAUTHENTICATED=false
